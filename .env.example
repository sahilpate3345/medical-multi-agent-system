# ========================================
# AI Health Backend Environment Variables
# ========================================

# Groq Cloud API Key for AI Assistant & RAG
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq Model Name (e.g. llama-3.3-70b-versatile, llama3-70b-8192, openai/gpt-oss-20b)
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Authentication Secret Key
SECRET_KEY=my-secret-key-change-later

# Google Drive File ID for downloading Xraymodel.h5 (Optional if model exists locally)
XRAY_MODEL_ID=
